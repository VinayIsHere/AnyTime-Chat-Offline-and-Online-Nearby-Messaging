<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        NoActionBar so the WebView owns the whole surface — the app draws its own
        header in React.

        windowOptOutEdgeToEdgeEnforcement opts out of the forced edge-to-edge
        layout Android 15 (API 35) applies by default. Without it the status bar
        becomes transparent and content slides underneath, which would mean
        handling insets in CSS for one Android version. Opting out keeps the
        status bar opaque and the page starting below it, matching how the UI is
        already laid out.

        The light status bar pairs with the app's default light theme. A user who
        switches to dark in Profile gets a light-on-dark status bar mismatch for
        now; fixing that needs a runtime call, not a static style.
    -->
    <style name="Base.AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <!--
            The launch splash, not a plain colour: this is what Android paints
            the moment the icon is tapped, before the process has run a line of
            our code. See drawable/splash.xml.

            AnyTimeActivity swaps it for the plain background once the web UI is
            up, so the logo cannot show through wherever the page does not
            cover the window.

            It is the light theme's background. Someone who chose dark in
            Profile sees a light splash first — same cause as the status bar
            note above: the choice lives in the page, out of a static style's
            reach.
        -->
        <item name="android:windowBackground">@drawable/splash</item>
    </style>

    <!-- Split from the base so values-v31 can add to it without repeating it. -->
    <style name="AppTheme" parent="Base.AppTheme" />
</resources>
