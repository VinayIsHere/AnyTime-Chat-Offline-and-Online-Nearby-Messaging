<?xml version="1.0" encoding="utf-8"?>
<!--
    The launch splash: the logo tile on the page background.

    Used twice, so the two cannot disagree —
      1. as the theme's windowBackground, which Android paints the instant the
         icon is tapped, before any of our code runs;
      2. as Qt's splash (android.app.splash_screen_drawable in the manifest),
         which stays on top until the web UI has loaded.

    THE TILE IS NOT CENTRED, ON PURPOSE. The web splash that takes over
    (ui/src/screens/SplashScreen.tsx) stacks the tile above the name and
    tagline, which puts the tile about 108dp above the middle of the screen. A
    bottom inset of twice that moves this one up by the same amount, so the
    hand-over from native to web does not jump. If the web layout changes,
    change this inset with it.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:opacity="opaque">
    <item android:drawable="@color/splash_background" />
    <item
        android:width="104dp"
        android:height="104dp"
        android:bottom="216dp"
        android:drawable="@drawable/splash_logo"
        android:gravity="center" />
</layer-list>
